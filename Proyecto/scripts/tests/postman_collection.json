{
  "info": {
    "name": "Auto Motores API Tests",
    "description": "Colección de pruebas para el sistema Auto Motores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api_test.php/health",
          "host": ["{{base_url}}"],
          "path": ["api_test.php", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has status OK', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('OK');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get All Mecanicos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api_test.php/mecanicos",
          "host": ["{{base_url}}"],
          "path": ["api_test.php", "mecanicos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "pm.test('Response time is less than 500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Mecanico",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"telefono\": \"123456789\",\n  \"direccion\": \"Calle 123\",\n  \"especialidad\": \"Motor\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api_test.php/mecanicos",
          "host": ["{{base_url}}"],
          "path": ["api_test.php", "mecanicos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Mecanico created successfully', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.message).to.include('creado');",
              "    pm.expect(jsonData.id).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Load Test - Get Mecanicos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api_test.php/mecanicos",
          "host": ["{{base_url}}"],
          "path": ["api_test.php", "mecanicos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Response time under 200ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(200);",
              "});",
              "",
              "pm.test('No server errors', function () {",
              "    pm.response.to.not.have.status(500);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost/auto-motores/tests"
    }
  ]
}
